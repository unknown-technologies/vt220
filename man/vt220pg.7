.\" TODO: this is ultra hacky, but it works ... at least for now
.\" The TL/IL/BPC macros are used for tagged/indented lines instead of
.\" paragraphs. This means there is *no* paragraph break between such
.\" lines. It is intended for bullet point lists without empty lines
.\" in-between.
.\" Since groff updates broke this at some point, there is an if/else
.\" as well as a fallback which should always work although this
.\" fallback will not indent wrapped lines.
.ie d an*break-paragraph \{\
.  de1 TL
.  \"  an*break-paragraph
.    if \\n[.$] .nr an-prevailing-indent (n;\\$1)
.    if '\\n[.z]'an*paragraph-tag' \{\
.      an-warn cannot nest .\\$0 or .TQ inside .\\$0; supply a tag
.      return
.    \}
.    nr an*have-paragraph-tag 1
.    itc 1 an*input-trap
.    in 0
.    ll -\\n[an-margin]u
.    nr an*saved-adjustment-mode \\n[.j]
.    di an*paragraph-tag
.    na
.  .
.
.  de1 IL
.    nr an*enforce-tag-separation 0
.  \"  an*break-paragraph
.    ie !\\n[.$] \{\
.      ne (1v + 1u)
.      in (\\n[an-margin]u + \\n[an-prevailing-indent]u)
.    \}
.    el \{\
.      ie (\\n[.$] > 1) .TL "\\$2"
.      el               .TL
.      nop \&\\$1
.    \}
.    nr an*enforce-tag-separation 1
.  .
.\}
.el \{\
.  ie d an-break-paragraph \{\
.    de1 TL
.    \"  an-break-paragraph
.      if \\n[.$] .nr an-prevailing-indent (n;\\$1)
.      itc 1 an-input-trap
.      in 0
.      if !\\n[an-is-in-diversion] \{\
.        ll -\\n[an-margin]u
.        di an-div
.        na
.      \}
.      nr an-is-in-diversion 1
.    .
.    de1 IL
.    \"  an-break-paragraph
.      ie !\\n[.$] \{\
.        ne (1v + 1u)
.        in (\\n[an-margin]u + \\n[an-prevailing-indent]u)
.      \}
.      el \{\
.        ie (\\n[.$] > 1) .TL "\\$2"
.        el               .TL
.        nop \&\\$1
.      \}
.    .
.  \}
.  el \{\
.    de1 TL
.      nop \\$*
.    .
.    de1 IL
.      nop \\$1
.    .
.  \}
.\}
.de BPC
.IL \(bu 2
.na
\\$1
.br
.ad
..
.
.SH NAME
VT220 Programmer Pocket Guide, 2nd Edition (July 1984)
.
.
.\""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
.SH "INTRODUCTION"
This pocket guide provides a summary of the information contained in the
.I VT220 Programmer Reference Manual
(EK-VT220-RM) which you can order from Digital. The guide provides a
quick reference tool for people with a knowledge of computer programming
to access the VT220 features.
.
.
.\""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
