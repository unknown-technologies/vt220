.\" vim:set tw=72 cc=72 spell spelllang=en:
.\"
.TH VT220PG 7 "September 2026" "unknown technologies"
.\"
.\" FIXME: This is an ugly hack to avoid strange space in tables caused
.\" by invisible page breaks.
.\" The hack sets the page size to "very large"
.\".if n .pl 32767u
.if n .pl 262144u
.
.\" Bulleted paragraph
.de bP
.  ie n  .IP \(bu 4
.  el    .IP \(bu 2
..
.
.\" Numbered paragraph
.de nP
.  ie n  .IP \\$1. 4
.  el    .IP \\$1. 2
..
.
.de nI
.  ie n  .IP "" 4
.  el    .IP "" 2
..
.
.\" Bold and italic simultaneously
.de1 Bi
.  nop \\f(BI\\$*\\fR \\c
..
.
.\" Sub-subsection, typeset it like a subsection for now
.de1 SSS
.  SS \\$*
..
.
.\" Numbered table
.de1 TBL
.  SS "Table \\$1  \\$2"
..
.
.\" Numbered figure
.de1 FIG
.  SS "Figure \\$1  \\$2"
..
.
.\" Sub-sub-subsection, typeset it like a section with no break
.de1 SSU
.  P
.  B "\\$1" \(em
..
.
.\" various symbols, properly typeset on TTY and UTF-8
.ie !'\*[.T]'utf8' \{\
.  ds mu u
.  ds dg +
.  ds d2 \(Do
.  ds oct (8)
.  ds dec (10)
.  ds bin (2)
.  ds hl -
.  ds vl |
.  ds elb +
.  ds erb +
.  ds elt +
.  ds ert +
.  ds xl +
.  ds lt +
.  ds rt +
.  ds tt +
.  ds bt +
.  ds -> >
.  ds <- <
.  ds ua ^
.  ds da v
.  ds error ?
.\}
.el \{\
.  ds mu \(*m
.  ds dg \[u253C]
.  ds d2 \[u256A]
.  ds oct \[u2088]
.  ds dec \[u2081]\[u2080]
.  ds bin \[u2082]
.  ds hl \[u2500]
.  ds vl \[u2502]
